# Скопируй в .env и заполни реальными значениями. .env в git не коммитится (см. .gitignore).

# Ключ авторизации (OAuth app) основного портала bot24.bitrix24.ru.
# Выпускается в разделе "Ключи авторизации" на vibecode.bitrix24.tech.
# Нужен ТОЛЬКО для встраивания виджета в интерфейс Битрикс24 и определения
# личности сотрудника через Gateway (см. app/auth.py). Для создания чатов
# и отправки сообщений (фоновые операции) больше НЕ используется — см. ниже.
VIBE_APP_KEY=vibe_app_...

# Личный API-ключ (не ключ авторизации!) — для ФОНОВЫХ операций: регистрация
# бота, создание чата и отправка сообщений через Бот-платформу
# (app/vibe_client.py, app/poller.py, app/routes/portals.py).
# Выпускается в разделе "Ключи API" на vibecode.bitrix24.tech (НЕ "Ключи
# авторизации" — это другой раздел и другой тип ключа).
# Обязательный скоуп Битрикс24: imbot (Бот-платформа). Просто im
# НЕДОСТАТОЧНО — регистрация бота/создание чата вернёт 403 SCOPE_DENIED.
# Скоупы Вайбкод можно снять все.
#
# ВАЖНО: не путать со скриптом scripts/deploy_backend.py — тот тоже просит
# "VIBE_API_KEY", но это ДРУГОЙ ключ (личный, скоуп vibe:infra), который
# задаётся только в shell-сессии перед запуском деплоя и НИКОГДА не кладётся
# сюда, в .env. Здесь — намеренно другое имя переменной
# (VIBE_BACKGROUND_API_KEY), чтобы два ключа не перепутать.
#
# Почему нельзя обойтись одним VIBE_APP_KEY: у ключа авторизации (vibe_app_)
# каждый запрос идёт от лица конкретного пользователя и требует
# Authorization: Bearer <сессионный токен>, а такой токен живёт 24 часа БЕЗ
# автопродления — получить его без интерактивного входа пользователя в
# браузере нельзя. Для планового опроса раз в ~45 сек (poller.py) это не
# работает: сессия истечёт на следующий день, а обновить её некому.
# Подробности: https://vibecode.bitrix24.tech/docs/keys-auth
VIBE_BACKGROUND_API_KEY=vibe_api_...

VIBE_API_BASE_URL=https://vibecode.bitrix24.tech

# Публичный URL ЭТОГО backend после деплоя на Black Hole/galaxy.
# Нужен для placement handler и OAuth redirect_uri (см. scripts/bind_placement.py).
APP_BASE_URL=

PLACEMENT_TITLE=Message Aggregator

# Этап 2. ЛОКАЛЬНО можно оставить путь ниже как есть.
# В ПРОДАКШЕНЕ (galaxy-сервер) ФС эфемерна между деплоями — обязательно
# указать путь внутри /data (единственный переживающий передеплой том),
# например: DATABASE_URL=sqlite:////data/app.db
DATABASE_URL=sqlite:///./db/app.db

# Сгенерировать один раз: python -c "from app.crypto import generate_encryption_key; print(generate_encryption_key())"
# НЕ МЕНЯТЬ после того, как в БД уже появятся зашифрованные записи —
# старые credentials станет невозможно расшифровать.
CREDENTIALS_ENCRYPTION_KEY=
